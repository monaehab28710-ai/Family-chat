{
  "expo": {
    "name": "Agon Preview",
    "slug": "agon-preview",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFF8F2",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.familyconnect.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "FamilyConnect uses the microphone so you can send voice messages to your family.",
        "NSPhotoLibraryUsageDescription": "FamilyConnect needs access to your photos so you can share pictures with your family."
      }
    },
    "android": {
      "package": "app.familyconnect.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FF6B4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "FamilyConnect uses the microphone so you can send voice messages to your family."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "552f0665-e30d-4f11-9ea9-97bc22a22809"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/552f0665-e30d-4f11-9ea9-97bc22a22809"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "arcadalabs",
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}